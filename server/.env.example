# TruyenCloud Backend Environment Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Base URL for static assets and self-referencing links
# Change this when deploying to production (e.g. https://truyen.achatvn.com).
# POST /v1/app/version chỉ nhận download_url cùng origin với BASE_URL (hoặc /static/...).
BASE_URL=http://127.0.0.1:8000

# CORS allowed origins (comma-separated)
# Use "*" for development, specific origins for production
# e.g. CORS_ORIGINS=https://app.truyencloud.vn,capacitor://localhost
# Khi DEBUG=false, "*" bị bỏ qua (không cho origin trình duyệt nào) — app di động không cần CORS.
CORS_ORIGINS=*

# Khoá quản trị (/admin, /v1/admin/*, phát hành APK, đổi model/hồ sơ dịch dùng chung).
# BẮT BUỘC >= 32 ký tự, nếu không các route quản trị trả 503. Tạo khoá:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# Ngoài ra tài khoản có "is_admin": true (python manage_users.py set-admin <user>) cũng có quyền quản trị.
ADMIN_KEY=

# Khoá ký token phiên (>= 16 ký tự). Bỏ trống thì tự sinh và lưu ở data/.session_secret.
SESSION_SECRET=

# Proxy được tin để lấy IP thật qua CF-Connecting-IP / X-Forwarded-For (IP hoặc CIDR).
# Mặc định chỉ loopback (cloudflared cùng máy). docker-compose.yml tự thêm 172.16.0.0/12 (gateway cầu nối Docker).
# ĐỪNG bỏ dấu # nếu chạy bằng docker compose: giá trị ở đây THAY THẾ mặc định của compose và làm mất dải 172.16.0.0/12,
# khi đó mọi người dùng bị gộp chung một IP (cùng xô giới hạn tần suất). Chỉ đặt khi subnet Docker nằm ngoài dải đó.
# TRUSTED_PROXY_IPS=127.0.0.1,::1,172.16.0.0/12

# Mật khẩu tài khoản thử test1 — chỉ được tạo khi DEBUG=true và chưa có users.json.
# Không dùng lại làm ADMIN_KEY hay bất kỳ bí mật nào khác.
DEFAULT_TEST_PASSWORD=changeme_on_first_login

# Supabase Credentials (optional for offline/mock test, required for cloud sync)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Antigravity / Gemini Key (optional if using local Antigravity session or Google ADC)
GEMINI_API_KEY=
ANTIGRAVITY_API_KEY=

# Tuỳ chọn: đặt DB trong một thư mục được mount để -wal/-shm sống sót khi tạo lại container (xem docker-compose.yml)
TRUYENCLOUD_DB_PATH=

# --- Giọng đọc truyện: VieNeu-TTS (mã nguồn mở, ONNX trên CPU) chạy ngay trên máy chủ -------------------------------
# Không còn dịch vụ giọng nào khác. Khi giọng local chưa sẵn sàng (đang tải mô hình, lỗi, tắt, quá chậm) /v1/tts/stream
# trả 503 {"detail":"local_tts_unavailable"} và app đọc bằng giọng có sẵn của Android/iOS. Tiếng Trung luôn do giọng máy đọc.
# Bật/tắt giọng local (0 = tắt hẳn, không nạp mô hình, mọi yêu cầu giọng AI trả 503).
TTS_LOCAL_ENABLED=1
# Mô hình: v3nano (mặc định; 11 giọng, 24 kHz, ~600 MB RAM, nhanh hơn thời gian thực ~1,5 lần trên MiniPC 3 nhân)
# hoặc v3turbo (25 giọng, 48 kHz, 1,5-2 GB RAM, CHẬM hơn thời gian thực ~1,25 lần trên cùng máy). Đổi thì khởi động lại;
# danh mục giọng và khoá cache đi theo mô hình (tệp đã dựng của mô hình kia vẫn nằm đó, bị dọn dần theo LRU).
TTS_LOCAL_MODEL=v3nano
# Số luồng onnxruntime cho một lần dựng (MiniPC 4 nhân dùng chung với ứng dụng khác: 3). Dựng luôn tuần tự, một đoạn một lần.
TTS_LOCAL_THREADS=3
# Hạ độ ưu tiên CPU (nice, 0-19) của luồng dựng giọng để chừa CPU cho ứng dụng khác. Chỉ có tác dụng trên Linux.
TTS_LOCAL_NICE=5
# 1 = nạp mô hình ngay lúc khởi động (nền, không chặn /v1/health); 0 = chỉ nạp khi có người cần.
TTS_LOCAL_WARMUP=1
# Thư mục mô hình (HF_HOME). Mặc định server/data/hf; trong Docker /app/data/hf (volume) nên sống sót khi tạo lại container.
# Lần đầu cần mạng để tải (Nano ~270 MB, Turbo ~550 MB); sau đó chạy offline.
TTS_MODEL_DIR=
# Giây tối đa /v1/tts/stream chờ dựng một đoạn chưa có trong cache trước khi trả 503 (Cloudflare cắt ở 100 giây).
TTS_ONDEMAND_TIMEOUT=90
# Trần dung lượng data/tts_cache (MB); dọn LRU, không bao giờ xoá tệp vừa dùng trong 1 phút.
TTS_CACHE_MAX_MB=4096
# Trần số đoạn chờ trong hàng đợi dựng trước (/v1/tts/prerender, /v1/tts/prefetch). Việc "đang nghe" không bị chặn bởi trần này.
# Đầy thì việc kém quan trọng nhất (nền, vào sau cùng) nhường chỗ cho việc của chương đang đọc.
TTS_QUEUE_MAX=2000
# Số đoạn chưa có trong cache mà MỘT khách (IP) được chờ dựng cùng lúc ở /v1/tts/stream (app thật cần ~3). Quá thì 503 busy.
TTS_ONDEMAND_PER_CLIENT=8
# Đoạn văn dài hơn ngần này ký tự bị từ chối ở /v1/tts/stream (422 text_too_long); app luôn gửi mảnh <= ~300 ký tự.
TTS_MAX_TEXT_CHARS=2000
# Hệ số RTF (giây dựng / giây âm thanh) giả định cho tới khi máy chủ tự đo được. Để trống = theo mô hình (đo trên MiniPC
# Ryzen 3 PRO 2200GE, 3 nhân): v3nano 0.8 (đo 0,58-0,91), v3turbo 1.3 (đo ~1,25).
TTS_ASSUMED_RTF=

# --- Tựa truyện, tựa chương, từ khoá tìm kiếm: KHÔNG còn dùng Google -------------------------------------------------
# Từ điển convert cộng đồng (VietPhrase/Names/HanViet/PhienAm, commit GitHub được ghim + kiểm sha256) trả lời tức thì;
# Hy-MT2-1.8B sửa nền tựa hiện đại/tựa chương dễ sai trật tự rồi lưu cache dùng chung. Google chỉ còn cho bản dịch dự
# phòng NGUYÊN CHƯƠNG và tóm tắt truyện (văn bản dài). Dữ liệu từ điển không có giấy phép: chỉ dùng riêng, chỉ nằm trong
# ./data/dict, không bao giờ vào image hay repo.
# 0 = không dùng từ điển convert (về bảng Hán-Việt nhỏ dựng sẵn).
TITLE_DICT_ENABLED=1
# Thư mục từ điển + chỉ mục sqlite (~110 MB, dựng một lần ~1 phút ở luồng nền). Mặc định server/data/dict.
TITLE_DICT_DIR=
# 1 = máy chủ tự tải từ điển (~53 MB) lần đầu khởi động; 0 = chỉ dùng khi đã tải tay (python -m services.title_mt_model_store --with-dict).
TITLE_DICT_AUTO_DOWNLOAD=1
# Cache tựa đã tinh chỉnh (dùng chung mọi người dùng). Mặc định server/data/title_cache.sqlite.
TITLE_CACHE_PATH=
# Máy chủ Hy-MT2 (llama.cpp, dịch vụ truyencloud-mt trong docker-compose.yml). 0 = tắt hẳn mô hình, chỉ dùng từ điển.
TITLE_MT_ENABLED=1
TITLE_MT_URL=http://truyencloud-mt:8080
# Thư mục tệp mô hình Hy-MT2-1.8B-Q4_K_M.gguf (1,13 GB). Mặc định server/data/mt.
TITLE_MT_MODEL_DIR=
# Giây tối đa một lượt tìm kiếm chờ Hy-MT2 dịch từ khoá Việt -> Trung (phần còn lại chạy nền rồi tự cache).
TITLE_MT_INTERACTIVE_TIMEOUT=1.5
# Giây tối đa cho một yêu cầu tinh chỉnh nền.
TITLE_MT_BACKGROUND_TIMEOUT=30
# 0 = không tinh chỉnh nền (vẫn dịch từ khoá tìm kiếm bằng Hy-MT2 nếu bật).
TITLE_REFINE_ENABLED=1
# Trần số tựa chờ tinh chỉnh (đầy thì bỏ mục kém ưu tiên nhất: tựa chương trước, tựa sách sau).
TITLE_REFINE_QUEUE_MAX=3000
# Nghỉ giữa hai yêu cầu tinh chỉnh (ms) để chừa CPU cho giọng đọc.
TITLE_REFINE_PAUSE_MS=400
# Số chương đầu của mỗi mục lục được quét để gắn bản tinh chỉnh / xếp hàng khi mở truyện.
TITLE_REFINE_TOC_SCAN=200
